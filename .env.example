# ==============================================================================
# CAP-12 Warehouse Slotting & Pick-Path Optimization - Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Snowflake Connection Details
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_DATABASE=CAPSTONE_12_DB
SNOWFLAKE_SCHEMA=CLEAN
SNOWFLAKE_WAREHOUSE=CAP12_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# AWS S3 Storage & Stage Settings
AWS_S3_BUCKET=cap12-warehouse-erp-drop
SNOWFLAKE_STAGE=erp_s3_stage
access_key=your_aws_access_key
secret_access_key=your_aws_secret_key

# Spring Boot Application Settings
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=snowflake

# Frontend Settings
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Optimization Engine Defaults
DISPATCH_POINT_X=0.0
DISPATCH_POINT_Y=0.0
WALKING_SPEED=1.2
PICK_HANDLING_TIME=15.0

